---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { projects } from "../../data/projects";
import { writing } from "../../data/writing";
export function getStaticPaths() {
  return ["projects","about","approach","contact","writing",...projects.map(p=>`projects/${p.slug}`),...writing.map(w=>`writing/${w.slug}`)].map((slug)=>({params:{slug},props:{slug}}));
}
const {slug}=Astro.props;
const isArchive=slug==="projects";
const isInjaz=slug==="projects/injaz";
const isLife=slug==="projects/life-advise";
const isAbout=slug==="about";
const isApproach=slug==="approach";
const isContact=slug==="contact";
const isWriting=slug==="writing";
const projectSlug=slug.startsWith("projects/")?slug.split("/")[1]:null;
const archiveProject=projectSlug?projects.find(p=>p.slug===projectSlug):null;
const isOtherProject=!!archiveProject&&!isInjaz&&!isLife;
const writingSlug=slug.startsWith("writing/")?slug.split("/")[1]:null;
const writingItem=writingSlug?writing.find(w=>w.slug===writingSlug):null;
const isWritingDetail=!!writingItem;
const categories=[...new Set(projects.map(p=>p.category))];
const categoryNames:Record<string,string>={"Business platform":"منصة مؤسسية","Progressive web app":"تطبيق ويب تقدمي","Web application":"تطبيق ويب","Website":"موقع إلكتروني","Portfolio":"معرض أعمال","Experiment":"تجربة"};
const writingTitles:Record<string,string>={
"choose-node-framework":"كيف تختار إطار العمل المناسب لتطبيق Node.js القادم؟","node-caching-redis":"موضوعات متقدمة في Node.js: التخزين المؤقت","docker-brief-introduction":"Docker: مقدمة موجزة","life-advise-side-project":"مشروع جانبي: تطبيق Life-Advise","javascript-arrays-iterators":"سلسلة JavaScript 101: المصفوفات وطرقها والمكررات","javascript-scopes-execution-context":"سلسلة JavaScript 101: النطاق وسياق التنفيذ","javascript-functions":"سلسلة JavaScript 101: الدوال","javascript-variables-constants":"سلسلة JavaScript 101: المتغيرات والثوابت والكلمة let","javascript-loops":"سلسلة JavaScript 101: الحلقات التكرارية","free-javascript-resources":"مجموعة مصادر مجانية لتعلم JavaScript وتطوير الويب","conditional-loops-practice":"تدريبات على الشروط والحلقات في JavaScript","javascript-console-time":"ما هي console.time() في JavaScript؟","javascript-conditionals":"سلسلة JavaScript 101: الجمل الشرطية","javascript-syntax-variables-datatypes":"سلسلة JavaScript 101: الصياغة والمتغيرات وأنواع البيانات","javascript-introduction":"سلسلة JavaScript 101: مقدمة","document-designmode":"ما خاصية Document.designMode؟","what-to-write-about":"عمّ أكتب؟"};
const writingSummaries:Record<string,string>={
"choose-node-framework":"مقارنة عملية بين أطر عمل Node.js وفق احتياجات التطبيق والمفاضلات والقيود الواقعية للمطوّر.",
"node-caching-redis":"مقدمة لاستخدام Redis للتخزين المؤقت في تطبيق Node.js، مع مثال عملي ومقارنة لقراءات قاعدة البيانات المتكررة.",
"docker-brief-introduction":"مدخل للمبتدئين إلى Docker والحاويات والصور والمفاهيم الأساسية لتشغيل التطبيقات داخلها.",
"life-advise-side-project":"عرض لمشروع Life-Advise واتجاهه للعمل دون اتصال، مع الحفظ المحلي والإشعارات اليومية الاختيارية.",
"javascript-arrays-iterators":"درس في أساسيات JavaScript يركز على طرق المصفوفات وكيفية التعامل مع مجموعات البيانات.",
"javascript-scopes-execution-context":"شرح مبسط للنطاق وسياق التنفيذ ضمن سلسلة أساسيات JavaScript.",
"javascript-functions":"مدخل إلى الدوال ودورها في تنظيم السلوك القابل لإعادة الاستخدام.",
"javascript-variables-constants":"درس حول تعريف المتغيرات والثوابت واستخدام الكلمة let.",
"javascript-loops":"مقدمة عملية إلى أشكال الحلقات الشائعة لتكرار التعليمات في JavaScript.",
"free-javascript-resources":"مجموعة منتقاة من مصادر تعلم JavaScript وتطوير الويب.",
"conditional-loops-practice":"مادة تدريبية للتعامل مع الجمل الشرطية والحلقات في JavaScript.",
"javascript-console-time":"شرح قصير للدالة console.time() واستخدام أدوات المطور لقياس زمن التنفيذ.",
"javascript-conditionals":"دليل تمهيدي للتفرع المنطقي باستخدام if وif/else وswitch.",
"javascript-syntax-variables-datatypes":"مدخل إلى صياغة JavaScript والمتغيرات وأنواع البيانات للمبتدئين.",
"javascript-introduction":"المقال الافتتاحي في سلسلة أساسيات JavaScript.",
"document-designmode":"استكشاف لخاصية document.designMode وطريقة غير معتادة لجعل محتوى الصفحة قابلاً للتحرير.",
"what-to-write-about":"تدوينة تأملية قصيرة حول سؤال: عمّ يمكن أن نكتب؟"
};
const writingCategoryNames:Record<string,string>={JavaScript:"جافاسكريبت",React:"رياكت",Node:"Node.js",Tools:"أدوات",Projects:"مشروعات"};
---
{isArchive ? <SiteLayout title="الأعمال — أسامة إبراهيم" description="أرشيف المشروعات والتجارب الرقمية.">
<section class="page-hero"><div class="container"><small class="eyebrow">أعمال مختارة / أرشيف المشروعات</small><h1>مجموعة من الأشياء التي <em>بنيتها.</em></h1><p>مشروعات بمراحل مختلفة، ودروس بقيت معها. الروابط التاريخية مراجع للمشروعات وليست دليلاً على استمرار تشغيلها.</p><div class="case-meta"><span>{projects.length} مشروعاً</span><span>ويب · منتجات · تجارب</span></div></div></section>
<section class="section"><div class="container"><div class="archive-note"><b>دراستا الحالة المختارتان</b><p>إنجاز وLife-Advise يحصلان على المعالجة التفصيلية. يبقى الموضع الثالث للعرض المختار فارغاً عمداً، مع الاحتفاظ بسجلات المشروعات الثلاثة عشر في الأرشيف.</p><p><a href="/ar/projects/injaz/">إنجاز ↗</a> · <a href="/ar/projects/life-advise/">Life-Advise ↗</a></p></div>
<div class="project-filters" role="group" aria-label="تصفية المشروعات"><button type="button" data-filter="all" aria-pressed="true">الكل</button>{categories.map(c=><button type="button" data-filter={c} aria-pressed="false">{categoryNames[c]??c}</button>)}</div>
<div class="project-grid all-projects">{projects.map(p=><article class="project-card" data-category={p.category}><a class="project-cover" href={`/ar/projects/${p.slug}/`}><img src={p.image} alt={`صورة أرشيفية لمشروع ${p.name}`} loading="lazy"/><span class="status">{p.status.includes("development")?"قيد التطوير":"عمل تاريخي"}</span></a><div class="project-body"><small class="eyebrow">{categoryNames[p.category]??p.category}</small><h3><a href={`/ar/projects/${p.slug}/`}>{p.name}</a></h3><p>{p.description}</p><div class="tags">{p.stack.slice(0,3).map(tag=><span>{tag}</span>)}</div><a class="read-link" href={`/ar/projects/${p.slug}/`}>استكشف السجل ←</a>{p.source&&<div class="project-links"><a href={p.source} target="_blank" rel="noreferrer">مستودع المصدر ↗</a></div>}</div></article>)}</div>
</div></section>
<script>
const buttons=document.querySelectorAll<HTMLButtonElement>("[data-filter]");
const cards=document.querySelectorAll<HTMLElement>("[data-category]");
buttons.forEach(button=>button.addEventListener("click",()=>{const selected=button.dataset.filter??"all";cards.forEach(card=>{card.hidden=selected!=="all"&&card.dataset.category!==selected});buttons.forEach(item=>item.setAttribute("aria-pressed",String(item===button)))}));
</script></SiteLayout>
: isInjaz ? <SiteLayout title="إنجاز — دراسة حالة | أسامة إبراهيم" description="دراسة حالة عن توجيه المنتج وحوكمة التسليم في منصة إنجاز.">
<section class="page-hero"><div class="container"><a class="read-link" href="/ar/projects/">← جميع المشروعات</a><small class="eyebrow">دراسة حالة / ملكية المنتج والتسليم</small><h1>من احتياجات العمل اليومية إلى منتج تحكمه قواعد واضحة.</h1><p>إنجاز منصة لإدارة وتنظيم المؤسسات، يجري تطويرها لتوحيد إدارة الأفراد والمسؤوليات وسير العمل التشغيلي. والسؤال الذي يوجّه قرارات المنتج بسيط: هل تستطيع المؤسسة إدارة أعمالها المعتادة بثقة، دون تدخل المطوّر في كل مرة؟</p><div class="case-meta"><span>منتج قيد التطوير</span><span>مستودع المصدر خاص</span><span>الأدلة راجعت في 13 نوفمبر 2026</span></div></div></section>
<section class="section"><article class="container simple-content case-study">
<h2>الفكرة قبل الواجهة</h2><p>بدأ العمل من تحويل احتياجات إدارية متفرقة إلى مواصفات قابلة للاختبار. لا تُعامل الشاشات بوصفها المنتج كله؛ فالصلاحيات، وانتقالات الحالة، وسلامة السجلات، وإمكانية تشغيل الإدارة اليومية عناصر أساسية في تعريفه.</p>
<h3>حدود النظام المعمارية</h3><div class="diagram" aria-label="مخطط معماري توضيحي"><div class="diagram-node"><b>واجهة الويب</b><small>مسارات عمل بحسب الدور</small></div><div class="diagram-arrow">↓</div><div class="diagram-node"><b>الحد الموثوق</b><small>مصادقة · وظائف خادمية · إجراءات RPC</small></div><div class="diagram-arrow">↓</div><div class="diagram-node"><b>طبقة البيانات</b><small>PostgreSQL · سياسات RLS · ترحيلات</small></div><div class="diagram-arrow">↓</div><div class="diagram-node"><b>التحقق والأدلة</b><small>اختبارات متصفح · بيئة مؤقتة · سجلات مراجعة</small></div><p class="diagram-note">رسم تفسيري لحدود المسؤولية، وليس لقطة من واجهة المنتج أو مخطط نشر كامل.</p></div>
<h3>كيف يُدار التسليم؟</h3><div class="workflow"><div>تحديد المتطلبات</div><i>←</i><div>تثبيت قواعد الصلاحيات</div><i>←</i><div>اختبار السيناريوهات</div><i>←</i><div>قرار قبول موثق</div></div>
<h3>حالة الأدلة</h3><ul><li>قُبل نطاق WS-03 الأمني المحدد في 10 نوفمبر 2026؛ ولا يعني ذلك قبول دورة حياة الهوية أو المنتج كاملاً.</li><li>اجتازت مرحلة WS-03.5 Stage B اختبارات بصرية مركزة في 13 نوفمبر 2026، ضمن نطاقها المحدد.</li><li>أعمال دورة حياة الهوية (WS-04) وتصحيح سير المهام (WS-05) ما زالت قيد المراجعة في طلبات سحب غير مدمجة.</li><li>تصدير البيانات، واستعادة النسخ الاحتياطية، واختبارات الإصدار الشاملة ما زالت أعمالاً مفتوحة.</li></ul>
<div class="evidence"><b>حدود الادعاء</b><p>المنتج قيد التطوير. لا يوجد ادعاء بإطلاق إنتاجي عام أو قبول V1 كاملاً. كما لا تُنسب كتابة كل وحدة أو قرار معماري إلى شخص بعينه دون دليل.</p></div>
</article></section></SiteLayout>
: isLife ? <SiteLayout title="Life-Advise — دراسة حالة | أسامة إبراهيم" description="رحلة هندسية تاريخية ومراجعة استعادة مشروع Life-Advise.">
<section class="page-hero"><div class="container"><a class="read-link" href="/ar/projects/">← جميع المشروعات</a><small class="eyebrow">دراسة حالة / رحلة هندسية واستعادة</small><h1>تجربة صُممت لتبقى نافعة حتى عندما ينقطع الاتصال.</h1><p>كان Life-Advise مشروعاً للأقوال والنصائح، استكشف التخزين المحلي والعمل مع اتصال متقطع. وما يُعرض هنا هو رحلة تقنية تاريخية ومراجعة لاستعادة المشروع، لا ادعاء بأن النسخة القديمة تعمل اليوم.</p><div class="case-meta"><span>مشروع تاريخي</span><span>استعادة قيد المراجعة</span></div></div></section>
<section class="section"><article class="container simple-content case-study"><h2>أجيال تقنية مختلفة</h2><div class="timeline"><article><b>01</b><div><small>الجيل الأول</small><h4>Meteor · React · Dexie</h4><p>تجربة مبكرة في تطبيق ويب مع تخزين محلي عبر IndexedDB.</p></div></article><article><b>02</b><div><small>مرحلة التحديث</small><h4>React · React Router · Dexie</h4><p>واجهة أحدث مع فصل أوضح لمسارات العرض وإدارة البيانات المحلية.</p></div></article><article><b>03</b><div><small>مرحلة الاستعادة</small><h4>مراجعة المصدر والبيانات</h4><p>فحص المستودعات والنسخ المستعادة وتحديد ما يمكن إثباته قبل إعادة البناء.</p></div></article></div>
<h3>خريطة تطور توضيحية</h3><div class="diagram" aria-label="مخطط تطور توضيحي"><div class="diagram-node"><b>تطبيق Meteor التاريخي</b><small>React · Dexie · Service Worker</small></div><div class="diagram-arrow">↓</div><div class="diagram-node"><b>واجهة React</b><small>React Router · IndexedDB / Dexie</small></div><div class="diagram-arrow">↓</div><div class="diagram-node"><b>التحقق والاستعادة</b><small>بناء نظيف · حفظ محلي · بدء دون اتصال · مزامنة لاحقة</small></div><p class="diagram-note">مخطط تفسيري للأجيال التقنية، وليس صورة فعلية للتطبيق.</p></div>
<h3>ما الذي تثبته الأدلة؟</h3><ul><li>تحتوي المستودعات التاريخية على تجارب تخزين محلي باستخدام Dexie وIndexedDB، إضافة إلى ملفات Service Worker.</li><li>تُظهر نسختان مستعادتان 6,254 و6,255 سجلاً على الترتيب؛ هذه أعداد تخص الملفين المحددين وليست تقديراً لحجم المجموعة التاريخية كلها.</li><li>كان رابط النشر السابق يعيد خطأ HTTP 522 عند مراجعته في 13 نوفمبر 2026.</li></ul>
<div class="evidence"><b>حدود الادعاء</b><p>لم يُثبت بعد بناء نظيف ناجح، أو تشغيل دون اتصال من بداية باردة، أو مزامنة موثوقة بعد عودة الاتصال، أو إرسال إشعارات بنجاح. لذلك يُعرض المشروع بوصفه عملاً تاريخياً قيد الاستعادة.</p></div>
</article></section></SiteLayout>
: isOtherProject ? <SiteLayout title={`${archiveProject?.name} — سجل مشروع | أسامة إبراهيم`} description="سجل أرشيفي لمشروع من أعمال أسامة إبراهيم.">
<section class="page-hero"><div class="container"><a class="read-link" href="/ar/projects/">← جميع المشروعات</a><small class="eyebrow">سجل مشروع / عمل تاريخي</small><h1>{archiveProject?.name}</h1><p>{archiveProject?.description}</p><div class="case-meta"><span>{archiveProject?.status.includes("development")?"قيد التطوير":"سجل تاريخي"}</span>{archiveProject?.stack.map(s=><span>{s}</span>)}</div></div></section>
<section class="section"><article class="container simple-content"><h2>ما الذي يحفظه هذا السجل؟</h2><p>يحتفظ هذا المدخل بالمشروع ضمن أرشيف الأعمال، ويعرض المعلومات المتاحة دون افتراض أن النسخة المنشورة ما زالت تعمل أو أن كل تفاصيل التنفيذ موثقة.</p><h3>حدود الأدلة</h3><p>الوصف والتقنيات هنا مستمدة من سجل المشروع المتاح. لا نضيف نتائج أو مقاييس أو ادعاءات عن التشغيل الحالي دون تحقق مستقل.</p><div class="evidence"><b>حالة الدليل</b><p>مشروع تاريخي؛ حالة النشر والتوافق التشغيلي الحالي غير مؤكدة.</p></div><div class="case-links">{archiveProject?.source&&<a class="read-link" href={archiveProject.source} target="_blank" rel="noreferrer">مستودع المصدر ↗</a>}</div></article></section></SiteLayout>
: isAbout ? <SiteLayout title="نبذة — أسامة إبراهيم" description="سياق صغير عن العمل والكتابة وما بينهما.">
<section class="page-hero"><div class="container"><small class="eyebrow">سياق صغير / لا الحكاية كلها</small><h1>ما يشغلني هو <em>السبب</em> أكثر من العنوان.</h1><p>أبني تطبيقات ويب وأكتب عن التقنيات التي أستخدمها. وما عدا ذلك يمكن اكتشافه بهدوء من خلال الأعمال والأفكار التي أختار شرحها.</p></div></section>
<section class="section"><div class="container simple-content"><h2>أحب أن أجعل المعقد أسهل استخداماً.</h2><p>تنقلت مشروعاتي بين واجهات الويب والخدمات الخلفية وتطبيقات الويب التقدمية وأنظمة تساعد الناس على تنظيم أعمالهم. يهمني ما وراء الواجهة: فهم المشكلة، وما ينبغي للنظام تذكره، وما يحدث عندما لا تسير الأمور كما خُطط لها.</p><p>أدوّن أثناء العمل. تتحول بعض الملاحظات إلى مقالات تقنية، ويبقى بعضها مرتبطاً بمشروع بعينه. تساعدني الكتابة على التمهل أمام الفكرة ورؤية ما يصمد منها وما يحتاج إلى مراجعة.</p><h2>التعلم لا يملك نسخة نهائية.</h2><p>ما زلت أبني وأراجع وأتعلم. بعض المشروعات مستمر، وبعضها عمل تاريخي أنظر إليه الآن بمنظور مختلف قليلاً. أفضل أن أكون واضحاً بشأن الفرق.</p><p>وأحياناً تكون أفضل خطوة تالية هي إغلاق المحرر والتفرغ للحياة قليلاً.</p><a class="read-link" href="/ar/writing/">تصفّح أرشيف الكتابة ←</a></div></section></SiteLayout>
: isApproach ? <SiteLayout title="منهجي في العمل — أسامة إبراهيم" description="كيف أفكر في المشكلات والأنظمة والقرارات الهندسية.">
<section class="page-hero"><div class="container"><small class="eyebrow">منهج العمل / من السؤال إلى النظام</small><h1>القرارات الجيدة تبدأ بفهم <em>المشكلة.</em></h1><p>لا أتعامل مع التقنية كغاية مستقلة. أحاول فهم من سيستخدم النظام، وما الذي يجب أن يظل صحيحاً، وكيف نعرف أن الحل يعمل خارج المسار المثالي.</p></div></section>
<section class="section"><div class="container simple-content"><h2>ابدأ بما ينبغي أن يكون صحيحاً.</h2><p>أحوّل الاحتياجات إلى قواعد واضحة وسيناريوهات قابلة للاختبار، ثم أختار أبسط بنية تفي بها. أراجع حدود الثقة، وحالات الفشل، وما سيحتاج الفريق إلى تشغيله وصيانته.</p><h2>الأدلة قبل الثقة.</h2><p>نجاح البناء لا يثبت سلامة تجربة الاستخدام. أبحث عن اختبارات تغطي المسارات المهمة، ونتائج يمكن ربطها بنسخة محددة، وحدود معلنة لما لم يُختبر بعد.</p><h2>التوثيق جزء من العمل.</h2><p>أكتب القرارات وأسبابها حتى لا تصبح المعرفة رهينة الذاكرة أو وجود مطور بعينه. فالمنتج الجيد ينبغي أن يكون مفهوماً وقابلاً للإدارة.</p></div></section></SiteLayout>
: isContact ? <SiteLayout title="تواصل — أسامة إبراهيم" description="ابدأ محادثة حول البرمجيات والمنتجات الرقمية.">
