---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { featuredProjects } from "../data/projects";
---
<SiteLayout title="Osama Ibrahim — Building useful digital products" description="Full-stack developer building thoughtful web applications and digital products.">
<section class="hero"><div class="container hero-grid">
  <div class="hero-copy"><small class="eyebrow"><i></i> FULL-STACK DEVELOPER · PRODUCT BUILDER</small><h1>I build digital products that make <em>complex things</em> feel simple.</h1><p>From the first idea to the details that make software dependable, I turn real problems into clear, useful web experiences.</p><div class="hero-actions"><a class="button primary" href="/projects/">Explore my work ↗</a><a class="button secondary" href="/contact/">Let's talk →</a></div><div class="hero-note"><span></span> Thoughtful engineering. Clear communication. Practical outcomes.</div></div>
  <div class="hero-art" aria-label="Abstract product interface illustration"><div class="orbit orbit-a"></div><div class="orbit orbit-b"></div><div class="mock-window"><div class="mock-bar"><span>● ● ●</span><small>PRODUCT / SYSTEMS</small><b>● BUILDING</b></div><div class="mock-body"><aside><strong>OI<span>.</span></strong><i></i><i></i><i></i><i></i></aside><div class="mock-main"><small>WORKSPACE OVERVIEW</small><h3>Bring work into focus.</h3><div class="metric-row"><div><small>STRUCTURE</small><b>01</b><span>Clear foundations</span></div><div><small>WORKFLOW</small><b>02</b><span>Connected steps</span></div></div><div class="flow"><span>01<br /><b>Understand</b></span><i></i><span>02<br /><b>Design</b></span><i></i><span>03<br /><b>Deliver</b></span></div><footer>BUILT AROUND REAL WORK <b>↗</b></footer></div></div></div><div class="float-note note-one">⌘ <span><b>Purposeful by design</b><small>Not just another interface</small></span></div><div class="float-note note-two">✓ <span><b>Built to be dependable</b><small>Details matter</small></span></div></div>
</div><div class="container hero-bottom"><span>SELECTED WORK / 2022—2026</span><span>SCROLL TO EXPLORE ↓</span></div></section>
<section class="intro-band"><div class="container intro-grid"><small class="eyebrow">01 / WHAT I DO</small><p>I work across the product journey — <strong>understanding the problem, shaping the experience, engineering the system,</strong> and making sure the result works in the real world.</p><a class="circle-link" href="/approach/">↗</a></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><small class="eyebrow">02 / SELECTED WORK</small><h2>Projects with a <em>purpose.</em></h2></div><a class="read-link" href="/projects/">View all projects ↗</a></div><div class="project-grid">{featuredProjects.map((project) => <ProjectCard project={project} />)}</div></div></section>
<section class="statement"><div class="container"><small class="eyebrow">03 / THE PRINCIPLE</small><h2>Good software is more than code. It is <em>clarity, trust,</em> and a better way to get things done.</h2><a class="button light" href="/about/">A little about me ↗</a><b class="giant-mark">OI.</b></div></section>
<section class="section"><div class="container contact-cta"><div><small class="eyebrow">HAVE A PROJECT IN MIND?</small><h2>Let's make something <em>meaningful.</em></h2></div><a class="button primary" href="/contact/">Start a conversation ↗</a></div></section>
</SiteLayout>
